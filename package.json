{
  "name": "@adxable/eyes-on",
  "version": "0.1.0",
  "description": "Local daemon that computes, from repository history, whether and what a human must read before a change is merged.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "eyes-on": "bin/eyes-on.js"
  },
  "files": [
    "bin",
    "dist/src",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "genskill": "npm run build --silent && node dist/src/skill/gen.js",
    "pretest": "npm run build --silent",
    "test": "node --test --test-concurrency=4 \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
